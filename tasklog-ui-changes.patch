+/* =========================================================
+   ✏️ Task 수정 패널 — UI 개선 (2026-07)
+   테마색(흰색/검정) = var(--bg), 테마 회색 = var(--bg-1)
+   ========================================================= */
+
+/* [R3 #1] Task 입력창 포커스 테두리 제거 */
+#rp-task-name { border-radius: var(--radius-md); }
+#rp-task-name:focus { border-color: var(--border); }
+#rp-task-name:focus-visible { outline: none; }
+
+/* [Task #2] To Do 영역을 박스로: 배경=테마색(흰/검), 마감일 버튼 테두리는 옅은 회색·최대한 얇게 */
+.rp-form .dp-steps-section {
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: var(--space-15) var(--space-2);
+}
+.rp-form .step-cal-btn {
+  border: 0.5px solid var(--border);
+}
+
+/* [Task #3] Priority · Status 개별 항목 배경 = 테마색(흰/검) */
+.rp-form .rp-ei-btn,
+.rp-form .rp-status-btn {
+  background: var(--bg);
+}
+.rp-form .rp-ei-btn:hover,
+.rp-form .rp-status-btn:hover {
+  background: var(--surface-hover);
+}
+
+/* [Task #4] Project · Linked Tasks 박스 배경 = 테마색(흰/검) */
+.rp-form .proj-dd-trigger,
+#rp-prev-sel,
+#rp-next-sel {
+  background: var(--bg);
+}
+
+/* =========================================================
+   🔮 Mandalart — UI 개선 (2026-07)
+   테마색(흰색/검정) = var(--bg), 테마 회색 = var(--bg-1)
+   ========================================================= */
+
+/* [MDT #1] 왼쪽 만다라트 박스: 내부 상단 여백 1pt 늘리기 */
+.mdt-left-panel { padding-top: 1px; }
+
+/* [MDT #2] "연간 목표" 박스 배경 = 테마색(흰/검) */
+.mdt-perf-annual { background: var(--bg); }
+
+/* [MDT #3] 개별 section 카드 세로로 채워 '전체 실적 요약' 박스 하단 여백 제거 */
+.mdt-perf-summary-box { display: flex; flex-direction: column; }
+.mdt-perf-dash-list { flex: 1 1 auto; }
+.mdt-perf-dash-card {
+  flex: 1 1 auto;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+}
+
+/* [MDT #4] section 세부내역 박스 배경 = 테마색(흰/검) + [MDT #6] 스크롤 */
+.mdt-perf-section {
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-3);
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-height: 0;
+}
+.mdt-perf-section-head { flex: 0 0 auto; margin-bottom: var(--space-2); }
+.mdt-act-cards {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  padding: var(--space-25) 0 0;
+}
+
+/* [MDT #5] "전체" · "목표" 버튼: 테마 회색 배경 + 테두리 제거 */
+.mdt-perf-back,
+.mdt-smart-open-btn {
+  background: var(--bg-1);
+  border: none;
+}
+
+/* =========================================================
+   ✏️ Task 수정 패널 — 2차 개선 (2026-07)
+   ========================================================= */
+
+/* [R2 #1] Start·Due: 날짜+시간을 하나의 상자로, 열 폭 고정(due가 밀리지 않도록) */
+.rp-dt-cols { display: flex; gap: 10px; }
+.rp-dt-col { flex: 1 1 0; min-width: 0; }
+.rp-dt-row {
+  display: flex;
+  align-items: stretch;
+  gap: 0;
+  width: 100%;
+  box-sizing: border-box;
+  background: var(--bg);
+  border: 0.5px solid var(--border);
+  border-radius: var(--radius-md);
+  overflow: hidden;
+}
+.rp-dt-row:focus-within { border-color: var(--brand-primary); }
+.rp-dt-row .seg-date.field-input,
+.rp-dt-row .rp-time-inp {
+  border: none;
+  background: transparent;
+  border-radius: 0;
+}
+.rp-dt-row .field-input.seg-date:focus-within { border-color: transparent; }
+.rp-dt-row .seg-date { flex: 1 1 auto; min-width: 0; justify-content: center; }
+.rp-dt-row .rp-time-inp {
+  flex: 0 0 54px;
+  width: 54px;
+  border-left: 0.5px solid var(--border);
+}
+
+/* [R2 #2] 클릭식 24시간 시계 */
+.sdp-clock-wrap { margin-top: 4px; padding-top: 0; border-top: none; }
+.sdp-clock { display: flex; flex-direction: column; align-items: center; gap: 8px; }
+.sdp-clock-head { display: flex; align-items: center; justify-content: space-between; gap: 4px; width: 100%; }
+.sdp-clock-seg {
+  font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums;
+  background: var(--surface); color: var(--text-2);
+  border: 1px solid var(--border); border-radius: var(--radius-sm);
+  padding: 2px 8px; cursor: pointer; min-width: 42px; text-align: center;
+  transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
+}
+.sdp-clock-seg.on {
+  color: var(--brand-primary); border-color: var(--brand-primary);
+  background: color-mix(in srgb, var(--brand-primary) 12%, transparent);
+}
+.sdp-clock-colon { font-size: 20px; font-weight: 700; color: var(--text-2); }
+.sdp-clock-spacer { flex: 1; }
+.sdp-clock-none {
+  font-size: var(--fs-2xs); color: var(--text-2);
+  background: var(--surface); border: 1px solid var(--border);
+  border-radius: var(--radius-full); padding: 3px 8px; cursor: pointer; white-space: nowrap;
+}
+.sdp-clock-none.on { color: var(--brand-primary); border-color: var(--brand-primary); }
+.sdp-clock-face {
+  position: relative; width: 210px; height: 210px;
+  border-radius: 50%; background: var(--bg-1); flex-shrink: 0;
+}
+.sdp-ck-num {
+  position: absolute; transform: translate(-50%, -50%);
+  width: 30px; height: 30px; border-radius: 50%;
+  display: flex; align-items: center; justify-content: center;
+  font-size: var(--fs-sm); font-variant-numeric: tabular-nums; line-height: 1;
+  background: transparent; border: none; color: var(--text-1);
+  cursor: pointer; z-index: 2; padding: 0;
+}
+.sdp-ck-num.inner { font-size: var(--fs-2xs); color: var(--text-2); }
+.sdp-ck-num:hover { background: var(--surface-hover); }
+.sdp-ck-num.on, .sdp-ck-num.inner.on { color: #fff; font-weight: 700; }
+.sdp-ck-hand { position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none; }
+.sdp-ck-hand line { stroke: var(--brand-primary); stroke-width: 2; }
+.sdp-ck-seldot { fill: var(--brand-primary); }
+.sdp-ck-center { fill: var(--brand-primary); }
+.sdp-clock-hint { font-size: var(--fs-2xs); color: var(--text-3); text-align: center; }
+
+/* [R2 #3] Project·Linked Tasks 글자색을 다른 칸처럼 회색으로 */
+.rp-form .proj-dd-trigger,
