+.mdt-detail-hero--split .mdt-hero-title {
+  flex: 0 0 25%;
+  max-width: 25%;
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  min-width: 0;
+}
+.mdt-hero-emoji { font-size: 22px; flex-shrink: 0; }
+.mdt-hero-name {
+  font-size: 15px; font-weight: 700;
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+}
+.mdt-detail-hero--split .mdt-hero-perf {
+  flex: 1 1 0;
+  display: flex;
+  align-items: center;
+  gap: var(--space-35);
+  min-width: 0;
+}
+.mdt-hero-perf .mdt-hero-bar { flex: 1 1 0; min-width: 60px; margin: 0; }
+.mdt-hero-pct   { font-size: 12px; color: var(--text-1); white-space: nowrap; }
+.mdt-hero-count { font-size: 12px; color: var(--text-2); white-space: nowrap; }
+
+/* [개선2] Project(행) 드래그 순서 변경 — 핸들 컬럼 + 드롭 위치 표시 */
+.mgt-th-drag { width: 26px; padding-left: 4px !important; padding-right: 0 !important; }
+.mgt-td-drag { width: 26px; padding-left: 4px !important; padding-right: 0 !important; text-align: center; vertical-align: middle; }
+.mgt-td-drag .tl-drag-handle { position: static; opacity: 0.4; }
+.mgt-row:hover .tl-drag-handle { opacity: 0.85; }
+.mgt-row.tl-dragging { opacity: 0.5; }
+.mgt-row.tl-drop-before td { box-shadow: inset 0 2px 0 0 var(--brand-primary); }
+.mgt-row.tl-drop-after  td { box-shadow: inset 0 -2px 0 0 var(--brand-primary); }
+
+/* [개선3] 달성형(실적) 목표: 이상/이하 선택 셀렉트 */
+.mgt-cmp-sel {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  color: var(--text-1);
+  border-radius: var(--radius-sm);
+  font-size: var(--fs-xs);
+  padding: 4px 6px;
+  font-family: inherit;
+  cursor: pointer;
+}
