+      var n = new Date();
+      window.selectCalDate(n.getFullYear(), n.getMonth(), n.getDate());
+      var el = document.getElementById('cal-detail');
+      if (el) {
+        try { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
