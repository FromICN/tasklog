diff --git a/style.css b/style.css
index c60f194..377eba8 100644
--- a/style.css
+++ b/style.css
@@ -10384,3 +10384,17 @@ body.light-mode .right-panel {
 .calw-ev.done { opacity: .55; text-decoration: line-through; }
